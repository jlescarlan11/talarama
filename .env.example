# Development PostgreSQL only. Use a pool URL here if needed.
DATABASE_URL="postgresql://DEV_USER:DEV_PASSWORD@localhost:5432/talarama_dev"
# Direct (non-pool) connection to the SAME development database.
DIRECT_URL="postgresql://DEV_USER:DEV_PASSWORD@localhost:5432/talarama_dev"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_DEVELOPMENT_SECRET"
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"
# Separate disposable database, never a development or production database.
TEST_DATABASE_URL="postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/talarama_test"
# Wikidata is the default key-free catalog. Set tmdb only for the legacy provider.
CATALOG_PROVIDER="wikidata"
# Server-only TMDB API Read Access Token (v4 bearer token). Never prefix NEXT_PUBLIC_.
TMDB_READ_TOKEN=""
# Optional on small local disks: disables persistent Next compiler disk cache only.
# Does not disable TMDB metadata caching or change authentication/privacy.
TALARAMA_DISABLE_COMPILER_CACHE="1"
# Optional PostgreSQL 17 client binary directory for migration backup/restore tests.
# Windows default: C:/Program Files/PostgreSQL/17/bin ; Linux/macOS default: PATH.
# PG_BIN="/usr/lib/postgresql/17/bin"
