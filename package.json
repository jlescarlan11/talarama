{
  "name": "talarama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:migrations": "node --env-file-if-exists=.env scripts/verify-migrations.mjs",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "6.19.3",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.0.35",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "next-themes": "^0.4.6",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "react-hook-form": "^7.56.4",
    "react-icons": "^5.5.0",
    "react-loading-skeleton": "^3.5.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "jsdom": "^26.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.14 <23",
    "npm": ">=11 <12"
  },
  "overrides": {
    "postcss": "^8.5.31"
  }
}
