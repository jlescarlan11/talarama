generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  username      String?       @unique
  email         String        @unique
  timeZone      String?
  bio           String        @default("")
  profilePublished Boolean    @default(false)
  showFavorites Boolean       @default(false)
  role          MemberRole    @default(MEMBER)
  reports       EntryReport[]
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  diaryEntries  DiaryEntry[]
  watchedMovies WatchlistEntry[]
  likedMovies   LikedBy[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Movie {
  id                String   @id @default(uuid())
  title             String
  description       String?
  releasedYear      Int?
  duration          Int?
  posterUrl         String?
  directorFirstName String?
  directorLastName  String?
  createdAt         DateTime @default(now())
  tmdbId            Int?     @unique
  metadataRefreshedAt DateTime?
  backdropUrl       String?
  credits           Json?
  tmdbScore         Float?

  genres       MovieCategorizesAs[]
  diaryEntries DiaryEntry[]
  watchedBy    WatchlistEntry[]
  likedBy      LikedBy[]

}

// Durable transactional mapping audit. Deliberately no cascading foreign key:
// history remains available even if catalog administration later removes a row.
model CatalogMappingAudit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  reviewer  String
  mappings  Json
}

model Genre {
  id        String               @id @default(uuid())
  genreName String               @unique
  movies    MovieCategorizesAs[]
}

model WatchlistEntry {
  user      User     @relation(fields: [userId], references: [id])
  movie     Movie    @relation(fields: [movieId], references: [id])
  createdAt DateTime @default(now())

  userId  String
  movieId String

  @@id([movieId, userId])
  @@map("WatchedList")
}

model LikedBy {
  user    User     @relation(fields: [userId], references: [id])
  movie   Movie    @relation(fields: [movieId], references: [id])
  likedAt DateTime @default(now())

  userId  String
  movieId String

  @@id([movieId, userId])
}

model MovieCategorizesAs {
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  movieId String
  genreId String

  @@id([genreId, movieId])
}

model DiaryEntry {
  id          String   @id @default(uuid())
  rating      Int?
  review      String @default("")
  visibility  DiaryVisibility @default(PRIVATE)
  isRewatch Boolean @default(false)
  containsSpoilers Boolean @default(false)
  clientRequestId String?
  moderationState ModerationState @default(VISIBLE)
  reports EntryReport[]
  watchedDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  movie       Movie    @relation(fields: [movieId], references: [id])
  userId      String
  movieId     String

  @@unique([userId, clientRequestId])
  @@index([userId, watchedDate, id])
  @@index([createdAt, id])
}

enum MemberRole {
 MEMBER
 ADMIN
}

enum ModerationState {
 VISIBLE
 HIDDEN
}

model EntryReport {
 id String @id @default(uuid())
 reporterId String
 entryId String
 reason String
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 reporter User @relation(fields:[reporterId], references:[id], onDelete:Cascade)
 entry DiaryEntry @relation(fields:[entryId], references:[id], onDelete:Cascade)
 @@unique([reporterId, entryId])
 @@index([createdAt, id])
}

// Audit IDs intentionally survive deletion of accounts, reports or diary entries.
model ModerationAudit {
 id String @id @default(uuid())
 adminId String
 reportId String
 entryId String
 action String
 createdAt DateTime @default(now())
}

model UsernameMappingAudit {
 id String @id @default(uuid())
 reviewer String
 mappings Json
 createdAt DateTime @default(now())
}

model MutationBucket {
 userId String
 kind String
 windowStart DateTime
 count Int
 expiresAt DateTime
 @@id([userId, kind, windowStart])
 @@index([expiresAt])
}

enum DiaryVisibility {
 PRIVATE
 PUBLIC
}
